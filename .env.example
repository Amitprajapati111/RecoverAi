# RecoverAI Environment Configuration

# Server
NODE_ENV=development
PORT=5000

# Primary Database & Distributed Cache
MONGODB_URI=mongodb://localhost:27017/recoverai
REDIS_URL=redis://localhost:6379

# Security & Tokens
JWT_SECRET=recoverai-jwt-secret-change-in-production-random-64-chars
JWT_REFRESH_SECRET=recoverai-refresh-secret-change-in-production-random-64-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=recoverai-encryption-key-32-chars!!

# Razorpay Test Mode Credentials (NEVER USE LIVE KEYS IN HACKATHON DEMO)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
RAZORPAY_ENV=test

# AI Provider Configuration ('mock' | 'openai' | 'anthropic')
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000
